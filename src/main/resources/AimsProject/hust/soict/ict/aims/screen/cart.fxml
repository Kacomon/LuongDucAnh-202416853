<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefWidth="1024.0" prefHeight="768.0"
            xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1">

    <!-- TOP: MenuBar + Header -->
    <top>
        <VBox>
            <MenuBar>
                <Menu text="Options">
                    <Menu text="Update Store">
                        <MenuItem text="Add Book"  onAction="#menuAddBookPressed"/>
                        <MenuItem text="Add CD"    onAction="#menuAddCDPressed"/>
                        <MenuItem text="Add DVD"   onAction="#menuAddDVDPressed"/>
                    </Menu>
                    <MenuItem text="View Store" onAction="#menuViewStorePressed"/>
                    <MenuItem text="View Cart"  onAction="#menuViewCartPressed"/>
                </Menu>
            </MenuBar>
            <Label text="CART" style="-fx-font-size: 50px; -fx-text-fill: #00ffff;">
                <VBox.margin><Insets left="10"/></VBox.margin>
            </Label>
        </VBox>
    </top>

    <!-- CENTER: Filter + TableView + Buttons -->
    <center>
        <VBox spacing="0">
            <padding><Insets left="10"/></padding>

            <!-- Filter row -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding><Insets top="10" bottom="10"/></padding>
                <Label text="Filter:"/>
                <TextField fx:id="tfFilter" prefWidth="180"/>
                <RadioButton fx:id="radioBtnFilterId" text="By ID" selected="true">
                    <toggleGroup><ToggleGroup fx:id="filterGroup"/></toggleGroup>
                </RadioButton>
                <RadioButton fx:id="radioBtnFilterTitle" text="By Title" toggleGroup="$filterGroup"/>
            </HBox>

            <!-- TableView -->
            <TableView fx:id="tblMedia" VBox.vgrow="ALWAYS" columnResizePolicy="CONSTRAINED_RESIZE_POLICY">
                <columns>
                    <TableColumn fx:id="colMediaTitle"    text="Title"/>
                    <TableColumn fx:id="colMediaCategory" text="Category"/>
                    <TableColumn fx:id="colMediaCost"     text="Cost"/>
                </columns>
            </TableView>

            <!-- Action buttons -->
            <ButtonBar>
                <padding><Insets top="8" bottom="8"/></padding>
                <buttons>
                    <Button fx:id="btnPlay"   text="Play"   onAction="#btnPlayPressed"/>
                    <Button fx:id="btnRemove" text="Remove" onAction="#btnRemovePressed"/>
                </buttons>
            </ButtonBar>
        </VBox>
    </center>

    <!-- RIGHT: Total + Place Order -->
    <right>
        <VBox alignment="TOP_CENTER" prefWidth="200.0">
            <padding><Insets top="50"/></padding>
            <HBox alignment="CENTER" spacing="10">
                <Label text="Total:" style="-fx-font-size: 24px;"/>
                <Label fx:id="lblTotal" text="0 $"
                       style="-fx-font-size: 24px; -fx-text-fill: #00ffff;"/>
            </HBox>
            <Button text="Place Order"
                    onAction="#btnPlaceOrderPressed"
                    style="-fx-font-size: 24px; -fx-text-fill: white; -fx-background-color: red;"
                    maxWidth="Infinity">
                <VBox.margin><Insets top="20" left="10" right="10"/></VBox.margin>
            </Button>
        </VBox>
    </right>

</BorderPane>
